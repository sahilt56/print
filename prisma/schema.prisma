// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Cafe {
  id             String     @id @default(uuid())
  name           String
  qrCode         String     @unique // e.g., 'cafe123'
  pricingConfig  String     // JSON string for prices
  logoUrl       String?
  printerConfig  String     // JSON string for printer settings
  createdAt      DateTime   @default(now())
  
  // Cafe Owner Authentication (Phase 4)
  ownerName      String?
  loginId        String?    @unique @map("email")
  password       String?    // Hashed password
  
  // Per-cafe Print Agent Security (Phase 5)
  agentSecretKey String?    @unique

  jobs           PrintJob[]
}

model PrintJob {
  id             String   @id @default(uuid())
  jobNumber      String   @unique
  cafeId         String
  cafe           Cafe     @relation(fields: [cafeId], references: [id])
  fileUrl        String
  fileName       String
  fileType       String
  pageCount      Int
  selectedPages  String   // e.g., "1,3,4-5" or "all"
  colorMode      String   // "bw" | "color"
  paperSize      String   // "a4"
  copies         Int
  pricePerPage   Float
  totalAmount    Float
  paymentMethod   String    // 'cash', 'online'
  paymentStatus   String    // 'pending', 'paid', 'failed'
  printStatus     String    // 'pending', 'printing', 'completed', 'cancelled', 'failed'
  
  // Payment Gateway (Phase 3)
  paymentGatewayOrderId   String?
  paymentGatewayPaymentId String?

  createdAt       DateTime  @default(now())
  updatedAt      DateTime @updatedAt
}
