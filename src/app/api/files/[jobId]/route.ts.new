import { readFile } from 'fs/promises';
import { basename, resolve } from 'path';
import { NextRequest } from 'next/server';
import dbConnect from '@/lib/dbConnect';
import PrintJob from '@/models/PrintJob';
import Cafe from '@/models/Cafe';
import { getAuthenticatedCafeId, verifyAgentToken } from '@/lib/security';
import { getPrivateDownloadUrl as getCloudinaryUrl } from '@/lib/cloudinary';
import { apiError, internalError } from '@/lib/api-utils';

async function resolveAuthorizedJobCafe(job: any) {
  const directCafe = await Cafe.findById(job.cafeId).lean();
  if (directCafe) {
    return directCafe;
  }

  const legacyCafeId = String(job.cafeId || '').trim();
  if (!legacyCafeId) {
    return null;
  }

  const legacyCafe = await Cafe.findOne({
    $or: [
      { qrCode: legacyCafeId },
      { loginId: legacyCafeId.toLowerCase() },
      { _id: legacyCafeId },
    ],
  });

  if (!legacyCafe) {
    return null;
  }

  job.cafeId = legacyCafe._id;
  await job.save();
  return legacyCafe;
}

export async function GET(
  request: NextRequest,
  { params }: { params: Promise<{ jobId: string }> }
) {
  try {
    await dbConnect();

    const { jobId } = await params;
    const job = await PrintJob.findById(jobId);
    if (!job) {
      return apiError('File not found', 404);
    }

    const jobCafe = await resolveAuthorizedJobCafe(job);
    if (!jobCafe) {
      return apiError('Cafe not found', 404);
    }

    const authHeader = request.headers.get('authorization');
    const token = authHeader?.replace(/^Bearer\s+/i, '').trim();
    const sessionCafeId = await getAuthenticatedCafeId();

    let authorizedCafeId: string | null = null;

    if (token) {
      const agentResult = await verifyAgentToken(token);
      if (!agentResult.valid || !agentResult.cafeDoc) {
        return apiError('Unauthorized', 401);
      }
      authorizedCafeId = String(agentResult.cafeDoc._id);
    } else if (sessionCafeId) {
      const sessionCafe = await Cafe.findOne({
        $or: [
          { qrCode: sessionCafeId },
          { loginId: sessionCafeId.toLowerCase() },
          { _id: sessionCafeId },
        ],
      });

      if (!sessionCafe) {
        return apiError('Unauthorized', 401);
      }
      authorizedCafeId = String(sessionCafe._id);
    }

    if (!authorizedCafeId) {
      return apiError('Unauthorized', 401);
    }

    if (String(jobCafe._id) !== authorizedCafeId) {
      return apiError('Forbidden', 403);
    }

    try {
      if (job.cloudinaryPublicId) {
        const cloudinaryResourceType = job.cloudinaryResourceType || (job.fileType?.toLowerCase().includes('pdf') ? 'raw' : 'image');
        const cloudinaryFormat = job.cloudinaryFormat || job.fileType || 'pdf';
        const downloadUrl = getCloudinaryUrl(
          job.cloudinaryPublicId,
          cloudinaryFormat,
          cloudinaryResourceType,
          300,
          job.cloudinaryVersion ?? undefined
        );

        return new Response(JSON.stringify({ downloadUrl }), {
          status: 200,
          headers: {
            'Content-Type': 'application/json; charset=utf-8',
            'Cache-Control': 'no-store',
            'X-Content-Type-Options': 'nosniff',
          },
        });
      }

      if (job.fileUrl) {
        const storedName = basename(job.fileUrl);
        const safeBaseDir = resolve(process.cwd(), 'uploads');
        const resolvedPath = resolve(safeBaseDir, storedName);

        if (!resolvedPath.startsWith(safeBaseDir) || !/^[a-f0-9]{32}\.(pdf|jpe?g|png)$/.test(storedName)) {
          return apiError('Invalid file reference', 404);
        }

        try {
          const fileContent = await readFile(resolvedPath);
          const MIME_TYPES: Record<string, string> = {
            'application/pdf': 'application/pdf',
            'image/jpeg': 'image/jpeg',
            'image/png': 'image/png',
          };

          return new Response(fileContent.toString('binary'), {
            headers: {
              'Content-Type': MIME_TYPES[job.fileType] ?? 'application/octet-stream',
              'Cache-Control': 'no-store',
              'X-Content-Type-Options': 'nosniff',
              'Content-Security-Policy': "default-src 'none'",
            },
          });
        } catch (error) {
          console.warn('[Files] Failed to read legacy local file', { jobId, file: storedName });
          return apiError('File not found', 404);
        }
      }

      return apiError('File not found', 404);
    } catch (error) {
      console.error('[Files] Failed to generate download URL', { jobId });
      return apiError('Failed to retrieve file', 500);
    }
  } catch (error) {
    return internalError(error, 'File Download');
  }
}
